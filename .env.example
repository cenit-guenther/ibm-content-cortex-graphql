# Copy to .env and adjust. The .env file is git-ignored; never commit credentials.

# Full URL of the GraphQL endpoint of your FileNet Content Services GraphQL installation
FILENET_GRAPHQL_URL=https://filenet.example.com:9443/content-services-graphql/graphql

# Symbolic name (or id) of the object store the examples work with
FILENET_OBJECT_STORE=OS1

# Basic authentication (default)
FILENET_USER=
FILENET_PASSWORD=

# Bearer authentication (optional). When set, it takes precedence over user/password.
FILENET_TOKEN=

# Folder below which the integration tests create (and delete) their test data. Default: /
FILENET_TEST_FOLDER=/

# Optional, curl only: PEM file with the CA certificate of your server
# (for Node.js use NODE_EXTRA_CA_CERTS, for Java use -Djavax.net.ssl.trustStore)
FILENET_CA_CERT=
